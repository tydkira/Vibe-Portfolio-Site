---
/**
 * Diary index (/diary)
 * Lists every non-draft movie-watching entry from the content collection.
 * Add an entry by creating a new .md file in src/content/diary/.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("diary", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.watchedDate.valueOf() - a.data.watchedDate.valueOf(),
);

/** Format a Date as a readable string, e.g. "Mar 12, 2026" */
function formatDate(date: Date): string {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<BaseLayout
	title="Diary"
	description="A diary of movie-watching experiences — what I saw, where, and how it landed."
>
	<section class="section">
		<div class="container">
			<span class="eyebrow">Watching log</span>
			<h1 class="animate-rise">Diary</h1>
			<p class="lede animate-rise-delay">
				Notes from nights at the theater and on the couch — the film, the
				context, and what stuck after the credits.
			</p>

			{
				entries.length === 0 ? (
					<p>
						No diary entries yet. Add a Markdown file in{" "}
						<code>src/content/diary/</code>.
					</p>
				) : (
					<ul class="diary-list">
						{entries.map((entry) => (
							<li>
								<a href={`/diary/${entry.id}`}>
									<div class="diary-meta">{formatDate(entry.data.watchedDate)}</div>
									<h3>{entry.data.title}</h3>
									<p class="diary-film">
										{entry.data.film}
										{entry.data.year ? ` (${entry.data.year})` : ""}
										{entry.data.where ? ` · ${entry.data.where}` : ""}
									</p>
									<p>{entry.data.description}</p>
									<div class="tag-row">
										{entry.data.tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</BaseLayout>
