---
/**
 * About page (/about)
 * Educate visitors on who you are — swap the placeholder bio for your own story.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../constants/site";
---

<BaseLayout
	title="About"
	description={`About ${SITE_NAME} — background, interests, and what I am working on.`}
>
	<section class="section">
		<div class="container about">
			<span class="eyebrow">About</span>
			<h1 class="animate-rise">{SITE_NAME}</h1>
			<p class="lede animate-rise-delay">
				I watch a lot of movies and write about them — a personal diary of what
				I see, plus a short newsletter for better Friday nights.
			</p>

			<div class="prose">
				<h2>What I care about</h2>
				<p>
					Clear writing. Films that stick with you after the credits. A
					newsletter that respects your time. I like recommendations that feel
					intentional — not another endless feed.
				</p>

				<h2>The diary</h2>
				<p>
					This site keeps a simple watching log: what I saw, where I saw it, and
					how it landed. Entries are Markdown files, so adding a new night out
					(or a couch rewatch) stays easy.
				</p>

				<h2>Outside the theater</h2>
				<p>
					New releases, comfort rewatches, or whatever a friend insists I “have
					to see.” Those picks feed both the diary and the newsletter.
				</p>

				<p>
					Want the short version of what I am watching?
					<a href="/newsletter">Subscribe to the movie newsletter</a>.
					Or browse the <a href="/diary">diary</a> for longer notes.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.about {
		max-width: 44rem;
	}

	.about h1 {
		margin-bottom: var(--space-md);
	}
</style>
