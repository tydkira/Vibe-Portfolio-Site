---
/**
 * Home page (/)
 * Goals: introduce who you are, share recent watches, and convert to newsletter signup.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SignupForm from "../components/SignupForm.astro";
import { SITE_NAME, SITE_IMAGES } from "../constants/site";
import { getCollection } from "astro:content";

// Pull published diary entries, newest first, show just a few on the home page
const entries = (await getCollection("diary", ({ data }) => !data.draft))
	.sort((a, b) => b.data.watchedDate.valueOf() - a.data.watchedDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title={SITE_NAME}
	description="Personal movie diary and newsletter from Ty Dunn."
>
	{/* ---- Hero: one composition — brand, headline, support, CTAs ---- */}
	<section class="hero">
		<div class="container hero__inner">
			<p class="hero__brand animate-fade">{SITE_NAME}</p>
			<h1 class="animate-rise">Films worth your Friday night.</h1>
			<p class="lede animate-rise-delay">
				I keep a short diary of what I watch and write a movie newsletter —
				clear picks, no algorithm noise.
			</p>
			<div class="button-row animate-rise-delay">
				<a class="button button--primary" href="/newsletter">Join the newsletter</a>
				<a class="button button--ghost" href="/diary">Read the diary</a>
			</div>
		</div>
		{/* Full-bleed theater photo behind the hero text */}
		<div class="hero__atmosphere" aria-hidden="true">
			<img
				class="hero__image"
				src={SITE_IMAGES.heroTheater}
				alt=""
				width="5000"
				height="3333"
				decoding="async"
				fetchpriority="high"
			/>
		</div>
	</section>

	{/* ---- Recent diary entries ---- */}
	<section class="section">
		<div class="container">
			<span class="eyebrow">Watching log</span>
			<h2>From the diary</h2>
			<p class="lede">A few recent movie nights — what I saw and how it landed.</p>

			<ul class="diary-list">
				{
					entries.map((entry) => (
						<li>
							<a href={`/diary/${entry.id}`}>
								<h3>{entry.data.title}</h3>
								<p class="diary-film">
									{entry.data.film}
									{entry.data.year ? ` (${entry.data.year})` : ""}
								</p>
								<p>{entry.data.description}</p>
								<div class="tag-row">
									{entry.data.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							</a>
						</li>
					))
				}
			</ul>

			<p style="margin-top: 1.25rem;">
				<a href="/diary">View the full diary →</a>
			</p>
		</div>
	</section>

	{/* ---- Newsletter conversion block ---- */}
	<section class="section section--signup">
		<div class="container signup-panel">
			<div>
				<span class="eyebrow">Newsletter</span>
				<h2>One short email. Better movie nights.</h2>
				<p class="lede">
					Weekly recommendations with just enough context to decide what to watch —
					and what to skip.
				</p>
			</div>
			<SignupForm id="home-signup" heading="Subscribe free" />
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		/* Fill most of the first viewport under the sticky header */
		min-height: calc(100vh - var(--header-height));
		display: flex;
		align-items: center;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		padding-block: var(--space-2xl);
		max-width: 40rem;
	}

	/* Brand as a hero-level signal, not just nav text */
	.hero__brand {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--color-heading);
		margin: 0 0 var(--space-md);
	}

	.hero h1 {
		margin-bottom: var(--space-md);
	}

	/* Full-bleed theater photo with a forest wash so text stays readable */
	.hero__atmosphere {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		/* Subtle zoom so the image feels alive */
		animation: hero-zoom 18s var(--ease-out) infinite alternate;
	}

	/* Tint + vignette: keep brand greens and protect heading contrast */
	.hero__atmosphere::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				90deg,
				rgba(42, 74, 47, 0.88) 0%,
				rgba(42, 74, 47, 0.62) 42%,
				rgba(53, 94, 59, 0.35) 100%
			),
			linear-gradient(
				180deg,
				rgba(42, 74, 47, 0.35) 0%,
				transparent 40%,
				rgba(42, 74, 47, 0.55) 100%
			),
			radial-gradient(ellipse 70% 80% at 85% 40%, rgba(232, 163, 14, 0.14), transparent 60%);
	}

	@keyframes hero-zoom {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.06);
		}
	}

	.section--signup {
		padding-block: var(--space-2xl);
	}

	.signup-panel {
		display: grid;
		gap: var(--space-lg);
		padding: var(--space-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 10px;
	}

	@media (min-width: 800px) {
		.signup-panel {
			grid-template-columns: 1.2fr 1fr;
			align-items: center;
			padding: var(--space-xl);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__image {
			animation: none;
		}
	}
</style>
